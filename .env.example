# Copy to .env and adjust. Every EPL_* variable maps to a field of epl_lakehouse.config.Settings.

# --- Lakehouse -------------------------------------------------------------------------
EPL_DATA_ROOT=./data
# Live API, or file:///path/to/sample-api for offline runs (see `epl sample-data`)
EPL_FPL_BASE_URL=https://fantasy.premierleague.com/api
EPL_INGEST_PLAYER_HISTORY=true

# --- HTTP client (be polite to the public API) -----------------------------------------
EPL_HTTP_TIMEOUT_SECONDS=30
EPL_HTTP_MAX_RETRIES=5
EPL_HTTP_BACKOFF_SECONDS=1.0
EPL_MAX_REQUESTS_PER_SECOND=4
EPL_MAX_WORKERS=4

# --- Spark -----------------------------------------------------------------------------
EPL_SPARK_MASTER=local[*]
EPL_SPARK_DRIVER_MEMORY=2g
EPL_SPARK_SHUFFLE_PARTITIONS=8
# Comma-separated jar paths/globs; when set, Delta jars are not resolved from Maven.
EPL_SPARK_JARS=

# --- Operations ------------------------------------------------------------------------
EPL_LOG_LEVEL=INFO
EPL_LOG_FORMAT=json
EPL_EXPECTED_TEAM_COUNT=20
EPL_VACUUM_RETENTION_HOURS=168

# --- Airflow (docker compose) ----------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate real values for anything shared:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
